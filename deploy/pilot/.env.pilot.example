# The pilot's settings. Copy to .env ON THE SERVER and fill in. Never commit .env or send it by e-mail.

# The address staff open (an intranet name IT points at this server), and how its certificate is made.
PORTAL_DOMAIN=recruitment.iefcl.local
PORTAL_TLS=internal
DJANGO_ALLOWED_HOSTS=recruitment.iefcl.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://recruitment.iefcl.local
SITE_URL=https://recruitment.iefcl.local
# A long random value, made on the server: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
SECURE_HSTS_SECONDS=31536000
TIME_ZONE=Africa/Lagos

# Database (PostgreSQL in the "db" service). Choose a strong password on the server.
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=

# Folders on the server: the shared folders the portal reads (mounted read-only at /inputs), where Portal
# updates.xlsx is written, and where nightly backups go (private storage only).
PORTAL_INPUTS_HOST_PATH=/srv/recruitment/inputs
PORTAL_EXPORTS_HOST_PATH=/srv/recruitment/exports
PORTAL_BACKUPS_HOST_PATH=/srv/recruitment/backups

# E-mail through Microsoft 365 (until set, e-mails are only written to the logs).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IEFCL Recruitment <recruitment@example.com>

# The recruitment mailbox (optional).
# CV_INBOX_HOST=outlook.office365.com
# CV_INBOX_USER=
# CV_INBOX_PASSWORD=

# AI stays off for real CVs until IEFCL has approved the provider and the data use.
ANTHROPIC_API_KEY=
AI_CV_PROCESSING_AUTHORISED=false
