# Copy to .env. Every setting is optional; the defaults run with no model at all.

# heuristic = no LLM, $0, deterministic.  llm = use the provider below.
RA_ENGINE=heuristic

# Free, local: install Ollama, then `ollama pull llama3.2:3b`.
RA_LLM_PROVIDER=ollama
RA_LLM_MODEL=llama3.2:3b
RA_OLLAMA_BASE_URL=http://localhost:11434

# Production on AWS (billed per token):
# RA_LLM_PROVIDER=bedrock
# RA_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# RA_AWS_REGION=us-east-1

RA_STORE=memory
# RA_STORE=dynamodb
# RA_DYNAMODB_TABLE=recruiter-agent-screenings

# Require an X-API-Key header on /v1 routes when set.
# RA_API_KEY=change-me
