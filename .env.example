# Copy to .env and adjust. Every value is optional for a local demo.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://recruitment.example.com
# Base URL used in email links (the address staff and candidates open)
SITE_URL=http://localhost:8000
TIME_ZONE=Africa/Lagos

# --- Database: SQLite by default; set these to use PostgreSQL ---
# POSTGRES_DB=recruitment
# POSTGRES_USER=recruitment
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Branding ---
COMPANY_NAME=Indorama Eleme Fertilizer & Chemicals Ltd.
COMPANY_SHORT_NAME=IEFCL
PORTAL_NAME=Recruitment Portal
COMPANY_LOCATION=Eleme, Rivers State, Nigeria

# --- Email (console backend prints emails to the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=recruitment@yourcompany.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=IEFCL Recruitment <recruitment@example.com>

# --- Recruitment mailbox read by `python manage.py fetch_cv_emails` (IMAP) ---
# CV_INBOX_HOST=outlook.office365.com
# CV_INBOX_PORT=993
# CV_INBOX_USER=careers@yourcompany.com
# CV_INBOX_PASSWORD=
# CV_INBOX_FOLDER=INBOX

# --- AI (Claude). Leave empty to run fully offline with rule-based reading. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_ENABLED=true
# Server-side refusal fallback (Claude API only). Set false behind other gateways.
AI_SERVER_FALLBACK=true

# --- OCR for scanned CVs when AI is off (needs the Tesseract program installed) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Recruitment rules ---
RETIREMENT_AGE=60
RETIREMENT_MAX_SERVICE_YEARS=35
RETIREMENT_ALERT_MONTHS=12
REQUISITION_NEEDS_MANAGEMENT_APPROVAL=false
AUTO_SHORTLIST_THRESHOLD=70
HND_EQUIVALENT_TO_BSC=false
TRAINEE_REQUIRES_MEDICALS=false
OFFER_VALIDITY_DAYS=7
MAX_UPLOAD_MB=10
# Video interview rooms when no Teams/Zoom link is pasted
MEETING_ROOM_BASE_URL=https://meet.jit.si
